doctype html
html(lang="en")
    head 
        title= `${title}`
        meta(name="viewport" content="width=device-width, initial-scale=1")
        link(rel="stylesheet", href="/css/style.css")
        
    body    
        .form-wrapper
            h1= service_ticket ? 'Update Service Request Details' : 'Create New Service Request'
            
            form(method="POST" action=service_ticket ? `/update-srobj/${service_ticket.id}` : '/update-srobj')
                .form-grid
                    if service_ticket
                        input(type="hidden" name="_method" value="PATCH")
                    
                    .form-field
                        label(for="customer_name") Customer Name
                        input(
                            type="text"
                            name="customer_name"
                            value=service_ticket ? service_ticket.properties.customer_name : ''
                            required
                        )

                    .form-field
                        label(for="appointment_date") Appointment Date
                        input(
                            type="datetime-local"
                            name="appointment_date"
                            value=service_ticket ? service_ticket.properties.appointment_date : ''
                            required
                        )

                    .form-field
                        label(for="service_type") Service Type
                        select(name="service_type" required)
                            option(value="" disabled selected)= "Select a service"
                            option(value="Oil Change" selected=service_ticket && service_ticket.properties.service_type === 'Oil Change') Oil Change
                            option(value="General Service" selected=service_ticket && service_ticket.properties.service_type === 'General Service') General Service
                            option(value="Detailing" selected=service_ticket && service_ticket.properties.service_type === 'Detailing') Detailing
                
                .form-submit
                    input(type="submit" value=service_type ? 'Update' : 'Create')